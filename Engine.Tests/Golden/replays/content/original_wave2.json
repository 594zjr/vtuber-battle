{
  "id": "original_wave2",
  "name": "原创主播·第二期",
  "notice": "本包角色、昵称、设定与文案均为本作虚构创作。免费、非商业使用；内容许可见 Packs/LICENSE.md。",
  "fields": {
    "og2_lens_hood": {
      "name": "星尺遮光罩", "kind": "turn", "when": "受到伤害时", "dispel": true,
      "dmgTakenMul": 0.85,
      "desc": "受到的普通技能伤害 ×0.85，不影响固定、持续、反噬和反弹伤害。回合类，可被消回合，下场清空。"
    }
  },
  "personas": {
    "og2_lamp_watch": {
      "name": "留灯值班", "code": "T_REGEN", "node": "回合结束",
      "params": { "frac": 0.05 },
      "desc": "回合结束时回复最大人气的 5%，不超过上限。回复即时结算；人设不可消除。"
    },
    "og2_split_finish": {
      "name": "分段报时", "code": "T_KO_HEAL", "node": "本方技能直接击倒对手后",
      "params": { "frac": 0.15 },
      "desc": "普通或固定技能伤害直接击倒对手后，自身回复最大人气的 15%，向下取整且不超过上限；对战已结束则不触发。持续伤害、反噬和反弹不触发；回复即时结算，人设不可消除。"
    },
    "og2_fold_brace": {
      "name": "折角加固", "code": "T_STAGE_ON_HIT", "node": "受到普通技能直接伤害后",
      "params": { "def": 1 },
      "desc": "受到普通技能直接伤害、实际失去人气且仍在播时，抗压 +1，最高 +6。固定伤害、持续伤害、反噬和反弹不触发；反弹使行动方下播后也不再触发。能力提升可被消强化，下场清零；人设不可消除。"
    },
    "og2_dark_adapt": {
      "name": "暗场校准", "code": "T_ENTER_FIELD", "node": "登场时",
      "params": { "turns": 3 }, "field": "og2_lens_hood",
      "desc": "每次登场获得「星尺遮光罩」3 回合，受到的普通技能伤害 ×0.85，不影响固定、持续、反噬和反弹伤害。遮光罩可被消回合，下场清空；人设本体不可消除。"
    },
    "og2_table_prep": {
      "name": "备料传盘", "code": "T_ALLY_PP_ON_ENTER", "node": "登场时",
      "params": { "n": 1 },
      "desc": "登场时，己方后排所有仍在播的队友每个技能 PP +1，不超过上限；不回复自身或已下播队友。回复即时结算；人设不可消除。"
    },
    "og2_coda": {
      "name": "尾奏返场", "code": "T_LOWHP_POWER", "node": "本方造成伤害时",
      "params": { "below": 0.3333, "mul": 1.4 },
      "desc": "自身人气低于约 1/3（33.33%）时，普通技能伤害 ×1.4；在伤害结算时读取人气，不影响固定伤害。人设不可消除。"
    },
    "og2_route_note": {
      "name": "夜路备忘", "code": "T_FIRST_CONTROL_IMMUNE", "node": "被施加控制类状态时",
      "params": {},
      "desc": "每次登场后，第一次本来可以施加的控制类状态无效；下场再登场重新计算。已有控制或重连保护已使施加无效时不消耗机会；人设不可消除。"
    },
    "og2_bench_pad": {
      "name": "工作台软垫", "code": "T_INTERACT_REDUCE", "node": "受到伤害时",
      "params": { "mul": 0.8 },
      "desc": "受到的互动类普通技能伤害 ×0.8，不影响固定伤害。人设不可消除。"
    },
    "og2_first_phrase": {
      "name": "开场转韵", "code": "T_FIRST_TURN_PRIO", "node": "排行动顺序时",
      "params": { "prio": 1 },
      "desc": "上场后第一个回合，所有技能先制 +1；回合中换入时从下一回合计。人设不可消除。"
    },
    "og2_clean_grid": {
      "name": "擦净网格", "code": "T_TURNSTART_CLEANSE", "node": "回合开始",
      "params": {},
      "desc": "回合开始时移除自身 1 个弱化类状态，不移除控制类状态。净化即时结算；人设不可消除。"
    },
    "og2_quiet_seats": {
      "name": "静听座席", "code": "T_BENCH_GUARD", "node": "受到伤害时",
      "params": { "per": 0.04 },
      "desc": "己方后排每有 1 位仍在播的队友，受到的普通技能伤害减少 4%；不影响固定伤害。人设不可消除。"
    },
    "og2_last_beat": {
      "name": "留住末拍", "code": "T_ENDURE", "node": "受到伤害时",
      "params": {},
      "desc": "每场对战一次，受到会使人气归零的伤害时保留 1 点人气；下场不重置。普通、固定、持续伤害和反噬均可触发，反弹不触发；人设不可消除。"
    }
  },
