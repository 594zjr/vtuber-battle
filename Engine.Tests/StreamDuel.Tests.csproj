<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pending/ 里是还没实现的任务的验收测试。做某个任务时把对应文件移出 Pending/。 -->
    <Compile Remove="Pending/**" />
    <None Include="Pending/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/StreamDuel.Core.csproj" />
    <Compile Include="../UnityProject/Assets/StreamDuel/Game/Screens/Replay/ReplayNavigator.cs" Link="T70/ReplayNavigator.cs" />
    <!-- 直接链接工具的纯数据层，避免可执行工程把真实下架政策复制到测试夹具。 -->
    <Compile Include="../Tools/Balance/BalanceSnapshot*.cs" Link="Balance/%(Filename)%(Extension)" />
    <Compile Include="../Tools/Balance/BalanceCompare*.cs" Link="Balance/%(Filename)%(Extension)" />
    <Compile Include="../Tools/Ladder/StyleComparison.cs" Link="Ladder/StyleComparison.cs" />
    <Compile Include="../Tools/Ladder/StyleComparisonOptions.cs" Link="Ladder/StyleComparisonOptions.cs" />
    <None Include="../UnityProject/Assets/StreamDuel/Resources/**/*.json" Exclude="../UnityProject/Assets/StreamDuel/Resources/PackPolicy.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Content" />
    <!-- 历史规则回归使用固定空政策；真实下架配置由 PackCheck 与独立部署烟测检查。 -->
    <None Update="Fixtures/PackPolicy.empty.json" CopyToOutputDirectory="PreserveNewest" TargetPath="Content/PackPolicy.json" />
  </ItemGroup>
</Project>
