.t134-card { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 18px; align-items: center; justify-content: center; background-color: rgba(3, 7, 19, 0.88); color: #edf2ff; font-size: 18px; }
.t134-card__panel { width: 100%; max-width: 1420px; height: 100%; min-width: 0; min-height: 0; padding: 16px; background-color: #151c38; border-color: #6179a4; border-width: 1px; border-radius: 12px; }
.t134-card__header { flex-direction: row; align-items: center; flex-shrink: 0; min-width: 0; margin-bottom: 10px; }
.t134-card__title { font-size: 27px; flex-grow: 1; min-width: 0; white-space: normal; margin-right: 14px; }
.t134-card__header > .t134-card__muted { margin-right: 12px; }
.t134-card__error { color: #ffb9bd; white-space: normal; min-width: 0; flex-shrink: 0; margin-bottom: 8px; }
.t134-card__button { min-width: 0; min-height: 42px; margin: 3px 5px; padding: 8px 16px; color: #edf2ff; background-color: #293b5d; border-color: #6179a4; border-width: 2px; border-radius: 7px; font-size: 18px; white-space: normal; -unity-text-align: middle-center; flex-shrink: 0; }
.t134-card__button:hover { background-color: #3d5279; }
.t134-card__button:focus { border-color: #ffe2a1; background-color: #354b70; }
.t134-card__button:disabled { opacity: 0.45; }
.t134-card__scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; border-width: 1px; border-color: #253354; border-radius: 7px; background-color: #10182d; }
.t134-card__scroll:focus { border-color: #ffe2a1; }
.t134-card__content { min-width: 0; padding: 16px; }
.t134-card__hero { flex-direction: row; align-items: center; flex-shrink: 0; min-width: 0; margin-bottom: 16px; }
.t134-card__avatar { width: 160px; height: 160px; flex-shrink: 0; margin-right: 22px; border-radius: 12px; background-color: #233153; align-items: center; justify-content: center; }
.t134-card__portrait { width: 156px; height: 156px; flex-shrink: 0; }
.t134-card__placeholder { font-size: 72px; color: #d8e6ff; -unity-text-align: middle-center; }
.t134-card__identity { min-width: 0; flex-grow: 1; flex-shrink: 1; }
.t134-card__name { font-size: 32px; white-space: normal; min-width: 0; margin-bottom: 8px; }
.t134-card__tracks { flex-direction: row; flex-wrap: wrap; align-items: center; min-width: 0; margin-top: 6px; }
.t134-card__track { color: #0c1124; padding: 5px 9px; margin: 3px 7px 3px 0; border-radius: 5px; white-space: normal; font-size: 18px; min-width: 0; flex-shrink: 1; }
.t134-card__category { color: #d1def7; margin: 3px 7px 3px 0; white-space: normal; min-width: 0; }
.t134-card__section { min-width: 0; flex-shrink: 0; margin-top: 8px; margin-bottom: 12px; }
.t134-card__section-title { font-size: 23px; color: #f0e4c6; white-space: normal; margin-top: 4px; margin-bottom: 9px; }
.t134-card__stat-grid { flex-direction: row; flex-wrap: wrap; min-width: 0; }
.t134-card__stat-row { width: 50%; min-width: 0; flex-shrink: 0; padding: 8px 14px 8px 0; }
.t134-card__stat-caption { flex-direction: row; flex-wrap: wrap; align-items: center; min-width: 0; margin-bottom: 5px; }
.t134-card__stat-name { white-space: normal; min-width: 0; flex-grow: 1; margin-right: 8px; }
.t134-card__stat-value { font-size: 21px; color: #f3f8ff; margin-right: 14px; }
.t134-card__bar { height: 12px; border-radius: 6px; background-color: #2d3b5c; overflow: hidden; }
.t134-card__fill { height: 100%; background-color: #81cbd4; border-radius: 6px; }
.t134-card__subtitle { font-size: 22px; white-space: normal; min-width: 0; margin-bottom: 6px; }
.t134-card__body { font-size: 18px; white-space: normal; min-width: 0; flex-shrink: 0; margin-top: 3px; margin-bottom: 5px; }
.t134-card__muted { color: #bfcce5; font-size: 16px; white-space: normal; min-width: 0; }
.t134-card__skill-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; min-width: 0; }
.t134-card__skill { width: 49%; min-width: 0; flex-shrink: 0; margin-right: 1%; margin-bottom: 12px; padding: 14px; background-color: #1d2846; border-color: #435878; border-width: 1px; border-radius: 8px; }
.t134-card__skill--fifth { width: 99%; border-color: #a78d5d; }
.t134-card__numbers { color: #e2ebff; white-space: normal; min-width: 0; margin-top: 6px; margin-bottom: 6px; }
.t134-card__effect { min-width: 0; flex-shrink: 0; margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-top-color: #40516e; }
.t134-card__timing { color: #ffe2a1; font-size: 16px; white-space: normal; margin-bottom: 2px; }
.t134-card__footer { flex-direction: row; align-items: center; flex-shrink: 0; min-width: 0; margin-top: 10px; }
.t134-card__controls { font-size: 15px; color: #bfcce5; white-space: normal; min-width: 0; flex-grow: 1; flex-shrink: 1; margin-left: 12px; }
