.rank-screen {
    flex-grow: 1;
    min-height: 0;
    padding: 32px 52px;
    background-color: #0c1124;
    align-items: center;
}
.rank-panel {
    width: 100%;
    max-width: 1700px;
    height: 100%;
    min-height: 0;
    padding: 24px 30px;
    background-color: #151c38;
    border-radius: 18px;
    border-width: 1px;
    border-color: #34426e;
}
.rank-heading { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; margin-bottom: 16px; }
.rank-title { color: #ffbf61; font-size: 36px; white-space: normal; flex-shrink: 0; }
.rank-muted { color: #b3bddc; font-size: 22px; white-space: normal; }
.rank-current { flex-direction: row; padding: 12px 16px; background-color: #10182e; border-radius: 12px; flex-shrink: 0; }
.rank-badge { width: 130px; height: 160px; margin-right: 24px; align-self: center; flex-shrink: 0; }
.rank-current-text { flex-grow: 1; min-width: 0; }
.rank-season { color: #c6d1f3; font-size: 24px; margin-bottom: 4px; white-space: normal; flex-shrink: 0; }
.rank-score-row { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 0; }
.rank-score { color: #f4f6ff; font-size: 36px; margin-right: 28px; white-space: normal; flex-shrink: 0; }
.rank-tier { color: #ffbf61; font-size: 30px; white-space: normal; flex-shrink: 0; }
.rank-copy { color: #e0e7ff; font-size: 22px; white-space: normal; flex-shrink: 0; margin-top: 4px; }
.rank-stats { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.rank-stats .rank-copy { margin-right: 30px; }
.rank-history-heading { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; margin-top: 14px; margin-bottom: 8px; }
.rank-subtitle { color: #e0e7ff; font-size: 27px; white-space: normal; }
.rank-history-buttons { flex-direction: row; }
.rank-history { flex-grow: 1; flex-shrink: 1; min-height: 80px; padding: 8px 12px; background-color: #0c1124; border-radius: 10px; }
.rank-history:focus { border-width: 2px; border-color: #ffda9b; }
.rank-history-row { padding: 12px 16px; margin-bottom: 8px; background-color: #1c2747; border-radius: 8px; flex-shrink: 0; }
.rank-history-name { color: #ffcf85; font-size: 24px; white-space: normal; flex-shrink: 0; }
.rank-empty { color: #b3bddc; font-size: 22px; padding: 16px; white-space: normal; flex-shrink: 0; }
.rank-notice-scroll { height: 74px; min-height: 74px; flex-shrink: 0; margin-top: 12px; }
.rank-notice { color: #b3bddc; font-size: 21px; white-space: normal; flex-shrink: 0; }
.rank-error { color: #ffb2b2; font-size: 22px; white-space: normal; flex-shrink: 0; }
.rank-footer { flex-direction: row; flex-shrink: 0; align-items: center; margin-top: 8px; }
.rank-button {
    min-height: 58px;
    min-width: 160px;
    margin: 0 12px 0 0;
    padding: 8px 20px;
    border-width: 3px;
    border-color: #455985;
    border-radius: 10px;
    background-color: #243255;
    color: #f0f3ff;
    font-size: 24px;
    white-space: normal;
    flex-shrink: 0;
}
.rank-button:hover { background-color: #344873; }
.rank-button:focus { border-color: #ffda9b; background-color: #344873; }
.rank-button:disabled { color: #9aa5c4; background-color: #202940; border-color: #303d5b; }
.rank-small-button { min-height: 44px; min-width: 130px; padding: 4px 12px; font-size: 20px; }
.rank-controls { color: #b3bddc; font-size: 18px; white-space: normal; margin-top: 10px; flex-shrink: 0; }
.rank-confirmation { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 8, 18, 0.94); align-items: center; justify-content: center; }
.rank-dialog { width: 88%; max-width: 1040px; height: 600px; max-height: 88%; padding: 30px; background-color: #1c2747; border-width: 2px; border-color: #ffbf61; border-radius: 18px; }
.rank-dialog-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 20px; margin-bottom: 24px; }
.rank-dialog-copy { color: #f0f3ff; font-size: 25px; white-space: normal; flex-shrink: 0; }
.rank-dialog .rank-error { margin-top: 18px; }
.rank-dialog-actions { flex-direction: row; justify-content: flex-end; flex-shrink: 0; }
.rank-compact { padding: 16px 24px; }
.rank-compact .rank-panel { padding: 16px 20px; }
.rank-compact .rank-heading { margin-bottom: 8px; }
.rank-compact .rank-title { font-size: 30px; }
.rank-compact .rank-badge { width: 100px; height: 124px; margin-right: 16px; }
.rank-compact .rank-current { padding: 8px 12px; }
.rank-compact .rank-season { font-size: 21px; }
.rank-compact .rank-score { font-size: 30px; }
.rank-compact .rank-tier { font-size: 26px; }
.rank-compact .rank-copy { font-size: 20px; }
.rank-compact .rank-history-heading { margin-top: 8px; margin-bottom: 6px; }
.rank-compact .rank-small-button { min-height: 36px; font-size: 18px; }
.rank-compact .rank-notice-scroll { height: 60px; min-height: 60px; margin-top: 8px; }
.rank-compact .rank-notice { font-size: 19px; }
.rank-compact .rank-button { min-height: 50px; font-size: 22px; }
.rank-compact .rank-controls { font-size: 16px; margin-top: 6px; }
